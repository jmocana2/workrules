# =============================================================================
# n8n Local - Variables de Entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores

# -----------------------------------------------------------------------------
# Supabase Local
# -----------------------------------------------------------------------------
# URL para acceder desde dentro del contenedor Docker
SUPABASE_URL=http://host.docker.internal:54321

# Service Role Key (de `supabase status`)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Anon Key (de `supabase status`)
SUPABASE_ANON_KEY=tu_anon_key_aqui

# -----------------------------------------------------------------------------
# APIs Externas (usa las mismas keys que en produccion)
# -----------------------------------------------------------------------------

# LlamaParse (https://cloud.llamaindex.ai/)
LLAMAPARSE_API_KEY=llx-xxxxx

# OpenAI (para embeddings)
OPENAI_API_KEY=sk-xxxxx

# Anthropic/Claude (para extraccion de perfil JSON)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# -----------------------------------------------------------------------------
# n8n Auth (para acceder a la interfaz web)
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=your_username_here
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here
