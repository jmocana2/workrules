# =============================================================================
# n8n - Variables de Entorno (local y prod usan el mismo formato)
# =============================================================================
# Copia este archivo a .env y rellena los valores. NO subir .env a git.
#
# Hay dos grupos:
#   [A] Lo consume el contenedor n8n (docker-compose.yml las inyecta)
#   [B] Almacen de keys: NO las usa Docker, solo para copy/paste al crear
#       las credenciales en la UI de n8n (Settings > Credentials)

# -----------------------------------------------------------------------------
# [A] Variables que consume el contenedor
# -----------------------------------------------------------------------------

# URL de Supabase. La consumen los workflows via $env.SUPABASE_URL.
#   Local: http://host.docker.internal:54321
#   Prod:  https://TU-PROJECT-REF.supabase.co
SUPABASE_URL=http://host.docker.internal:54321

# Auth basica de la UI de n8n (http://localhost:5678)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esto

# -----------------------------------------------------------------------------
# [B] Almacen de keys (para crear credenciales en la UI de n8n)
# -----------------------------------------------------------------------------
# Estas NO se inyectan al contenedor. Estan aqui para tenerlas centralizadas
# y poder copiarlas al rellenar las credenciales nativas de n8n.

# Supabase: service_role key (sale en `supabase status` en local, o en el
# dashboard de Supabase en prod). Va en la credencial "Supabase account".
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# LlamaParse (https://cloud.llamaindex.ai/)
# Va en la credencial "LlamaParse" (Header Auth), formato:
#   Header Name:  Authorization
#   Header Value: Bearer <LLAMAPARSE_API_KEY>
LLAMAPARSE_API_KEY=llx-xxxxx

# OpenAI (embeddings). Va en la credencial "OpenAi account".
OPENAI_API_KEY=sk-xxxxx

# Anthropic / Claude (extraccion de perfil JSON).
# Va en la credencial "Anthropic account".
ANTHROPIC_API_KEY=sk-ant-xxxxx
