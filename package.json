{
  "name": "workrules",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build-storybook && pnpm build-slides",
    "build-slides": "pnpm -C presentacion-tfm exec slidev build --out ../dist/presentacion-TFM --base /presentacion-TFM/ --router-mode hash",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:deno": "deno test --allow-all --config supabase/functions/deno.json supabase/functions",
    "test:coverage": "deno test --allow-all --config supabase/functions/deno.json --coverage=supabase/functions/coverage supabase/functions",
    "test:storybook": "test-storybook --url http://localhost:6006",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "tokens:build": "style-dictionary build --config style-dictionary.config.js",
    "slides-dev": "pnpm -C presentacion-tfm dev",
    "slides-build": "pnpm -C presentacion-tfm build",
    "slides-export": "pnpm -C presentacion-tfm export"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
