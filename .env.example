# ===========================================
# WorkRules - Variables de Entorno
# ===========================================
# Copia este archivo a .env.local y rellena los valores
# Las variables VITE_* se exponen al cliente (frontend)

# Supabase - Frontend (expuestas al cliente)
# Obtener de: https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.coVITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase - Backend (NO exponer al cliente)
# Usadas solo en Edge Functions y scripts de servidor
# IMPORTANTE: Estos valores deben coincidir con las variables VITE_* de arriba
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key